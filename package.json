{
  "name": "@radixdlt/connector-extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.0",
  "authors": [
    "Alex Stelea <alex.stelea@rdx.works>",
    "Dawid Sowa <dawid.sowa@rdx.works>"
  ],
  "bugs": "https://github.com/radixdlt/connector-extension/issues",
  "license": "Apache-2.0",
  "scripts": {
    "start": "VITE_DEV_TOOLS=true vite",
    "start:local": "VITE_DEV_TOOLS=true vite --mode localhost",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "build:dev": "tsc && tsc -p tsconfig.node.json && VITE_DEV_TOOLS=true vite build",
    "build:cd": "./build.sh",
    "preview": "vite preview",
    "prettier": "prettier --write src",
    "lint": "eslint & pnpm run prettier & tsc",
    "prepare": "husky install",
    "test": "vitest --reporter=basic",
    "test:ci": "vitest run --coverage --sequence.concurrent=false",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage"
  },
  "dependencies": {
    "@ledgerhq/hw-transport": "6.28.8",
    "@ledgerhq/hw-transport-webhid": "6.27.19",
    "@noble/curves": "1.4.0",
    "@radixdlt/babylon-gateway-api-sdk": "1.2.7",
    "@genkipool/radix-connect-iroh": "file:vendor/genkipool-radix-connect-iroh-0.2.0.tgz",
    "@radixdlt/radix-connect-webrtc": "1.2.2-csp.1",
    "@radixdlt/radix-dapp-toolkit": "2.2.0-dev.10",
    "@trpc/client": "10.45.4",
    "@trpc/server": "10.45.4",
    "bip32": "2.0.6",
    "bip39": "3.1.0",
    "blakejs": "1.2.1",
    "buffer": "6.0.3",
    "ed25519-hd-key": "1.3.0",
    "elliptic": "6.6.1",
    "lodash.chunk": "4.2.0",
    "loglevel": "1.8.1",
    "neverthrow": "6.2.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-qr-code": "2.0.11",
    "react-router-dom": "7.18.5",
    "rxjs": "7.8.1",
    "trpc-chrome": "1.0.0",
    "tslog": "4.8.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.22.7",
    "@babel/preset-typescript": "7.28.5",
    "@commitlint/cli": "17.6.6",
    "@commitlint/config-conventional": "17.6.6",
    "@crxjs/vite-plugin": "3.0.0",
    "@owlcode/semantic-release-chrome": "1.0.1",
    "@saithodev/semantic-release-backmerge": "3.2.1",
    "@semantic-release/exec": "6.0.3",
    "@types/chrome": "0.0.241",
    "@types/elliptic": "6.4.14",
    "@types/lodash.chunk": "4.2.7",
    "@types/node": "22.20.5",
    "@types/react": "18.2.14",
    "@types/react-dom": "18.2.6",
    "@types/w3c-web-hid": "1.0.3",
    "@typescript-eslint/eslint-plugin": "5.61.0",
    "@typescript-eslint/parser": "5.61.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "babel-preset-vite": "1.1.0",
    "dotenv": "16.3.1",
    "eslint": "8.44.0",
    "eslint-config-alloy": "5.1.2",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-unused-imports": "2.0.0",
    "husky": "8.0.3",
    "jsdom": "20.0.3",
    "prettier": "3.0.0",
    "sass": "1.70.0",
    "semantic-release": "21.0.7",
    "semantic-release-replace-plugin": "1.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-compatible-readable-stream": "3.6.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.12",
    "vitest-chrome": "0.1.0",
    "vitest-mock-extended": "5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/radixdlt/connector-extension.git"
  }
}
